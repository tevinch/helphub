{# Navigation markup adapted from oleeskild/digitalgarden 1.96.0 (MIT).
   Customize these exact folder paths; no leading or trailing slash. #}
{% set newestFirstFolders = ["Journal", "Projects/Log"] %}

{# Native groupby indexes existing note objects once per rendered page. #}
{% set navigationNotesByUrl = (collections.note or []) | groupby("url") %}

{% if settings.dgShowFileTree !== true %}
  {% include "components/navbar.njk" %}
{% else %}

    {% macro menuChildren(children, step, currentPath) %}
        {% if currentPath in newestFirstFolders %}
            {% set pinned = [] %}
            {% set folders = [] %}
            {% set notes = [] %}
            {% for name, child in children %}
                {% if child.isFolder %}
                    {% set ignored = folders.push({name: name, child: child}) %}
                {% elif child.isNote %}
                    {% set note = (navigationNotesByUrl[child.permalink] or [])[0] %}
                    {% set created = "" %}
                    {% if note.data.created %}
                        {% set created = note.data.created | dateToZulu %}
                    {% endif %}
                    {% set row = {name: name, child: child, created: created} %}
                    {% if child.pinned %}
                        {% set ignored = pinned.push(row) %}
                    {% else %}
                        {% set ignored = notes.push(row) %}
                    {% endif %}
                {% endif %}
            {% endfor %}
            {% for row in pinned | sort(true, false, "created") %}
                {{ menuItem(row.name, row.child, step, currentPath + "/" + row.name) }}
            {% endfor %}
            {% for row in folders %}
                {{ menuItem(row.name, row.child, step, currentPath + "/" + row.name) }}
            {% endfor %}
            {% for row in notes | sort(true, false, "created") %}
                {{ menuItem(row.name, row.child, step, currentPath + "/" + row.name) }}
            {% endfor %}
        {% else %}
            {% for name, child in children %}
                {{ menuItem(name, child, step, currentPath + "/" + name) }}
            {% endfor %}
        {% endif %}
    {% endmacro %}
  {% macro menuItem(fileOrFolderName, fileOrFolder, step, currentPath) %}
    {%if fileOrFolder.isNote or fileOrFolder.isFolder%}
        <div x-show="isOpen" style="display:none" class="{{'filelist' if step>0}}">
            {%if fileOrFolder.isNote and not fileOrFolder.hide %}
                <div @click.stop class="notelink {{ 'active-note' if fileOrFolder.permalink === permalink}}">
                    <a data-note-icon="{{fileOrFolder.noteIcon}}" style="text-decoration: none;" class="filename" href="{{fileOrFolder.permalink}}">{{fileOrFolder.name}} </a>
                </div>
            {% elif fileOrFolder.isFolder%}
                <div class="folder inner-folder"  x-data="{isOpen: $persist(false).as({{currentPath | dump}})}" @click.stop="isOpen=!isOpen">
                    <div class="foldername-wrapper align-icon">
                    <i x-show="isOpen" style="display: none;"  data-lucide="chevron-down"></i>
                    <i x-show="!isOpen"  data-lucide="chevron-right"></i>
                    <span class="foldername">{{fileOrFolderName}}</span>
                    </div>
                    {{ menuChildren(fileOrFolder, step+1, currentPath) }}
                </div>
            {% endif %}
        </div>
        {%endif%}
    {% endmacro %}

    <div x-init="isDesktop = (window.innerWidth>=1000) ? true: false;"
            x-on:resize.window="isDesktop = (window.innerWidth>=1000) ? true : false;"
            x-data="{isDesktop: true, showFilesMobile: false}">

        <div x-show.important="!isDesktop" style="display: none;">
            <nav class="navbar">
                <div class="navbar-inner">
                    <span style="font-size: 1.5rem; margin-right: 10px;" @click="showFilesMobile=!showFilesMobile"><i  data-lucide="menu"></i></span>
                    {% for imp in dynamics.filetree.beforeTitle %}
                        {% include imp %}
                    {% endfor %}
                    {% if meta.siteLogoPath %}
                    <a href="/" style="text-decoration: none; flex: 1; display: flex; justify-content: center;">
                            <img class="site-logo" src="{{meta.siteLogoPath}}" alt="{{meta.siteName}}">
                    </a>
                    {% else %}
                    <a href="/" style="text-decoration: none; text-align: center;">
                            <h1 style="margin: 15px !important;">{{meta.siteName}}</h1>
                    </a>
                    {% endif %}
                    {% for imp in dynamics.filetree.afterTitle %}
                        {% include imp %}
                    {% endfor %}
                </div>

                <div class="navbar-actions">
                    {% set slotName = "navbar.actions" %}{% include "components/pluginSlot.njk" %}
                    {% include "components/pagePanelButton.njk" %}
                </div>
            </nav>
        </div>

        <div x-show="showFilesMobile && !isDesktop" @click="showFilesMobile = false" style="display:none;" class="fullpage-overlay"></div>

      <div class="filetree-wrapper" x-show.important="isDesktop || showFilesMobile" style="display: none;">
      <nav class="filetree-sidebar">
        {% for imp in dynamics.filetree.beforeTitle %}
            {% include imp %}
        {% endfor %}
         {% if meta.siteLogoPath %}
         <a href="/" style="text-decoration: none; display: flex; justify-content: center;">
                   <img class="site-logo" src="{{meta.siteLogoPath}}" alt="{{meta.siteName}}">
         </a>
         {% else %}
         <a href="/" style="text-decoration: none; text-align: center;">
                   <h1 style="text-align:center;">{{meta.siteName}}</h1>
         </a>
         {% endif %}
         {% for imp in dynamics.filetree.afterTitle %}
            {% include imp %}
        {% endfor %}
        {% set slotName = "filetree.actions" %}{% include "components/pluginSlot.njk" %}
         <div class="folder" x-data="{isOpen: true}">
               {%- for fileOrFolderName, fileOrFolder in filetree -%}
                  {{menuItem(fileOrFolderName, fileOrFolder, 0, fileOrFolderName)}}
               {%- endfor -%}
         </div>
      </nav>
      </div>
    </div>
{% endif %}
