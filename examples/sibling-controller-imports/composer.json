{
  "name": "guide/sibling-controller-imports",
  "description": "Cross-package AssetMapper imports with explicit synchronization choices",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.4",
    "symfony/flex": "2.11.0",
    "symfony/framework-bundle": "8.1.10",
    "symfony/twig-bundle": "^8.1",
    "symfony/asset-mapper": "^8.1",
    "symfony/asset": "^8.1",
    "symfony/stimulus-bundle": "^3.6",
    "twig/twig": "^3.30",
    "guide/api-grid-bundle": "1.0.0",
    "symfony/console": "^8.1"
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/*",
      "options": {
        "symlink": false
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true
    },
    "sort-packages": true
  },
  "extra": {
    "symfony": {
      "endpoint": []
    },
    "symfony/flex": {
      "synchronize_package_json": true
    }
  }
}
